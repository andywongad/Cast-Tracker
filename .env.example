# Free personal API key from https://www.themoviedb.org/settings/api
# Server-only, and the one that matters: read by api/tmdb.ts, api/tvmaze.ts and
# api/check-episodes.ts. Unprefixed so Vite never inlines it into the client bundle.
# Set it in the Vercel dashboard; local dev doesn't need it, because vite.config.ts
# proxies /api to a deployed origin.
TMDB_API_KEY=

# Sign-up preview screens. Off unless "true". No backend behind them — see src/lib/auth.ts
VITE_ENABLE_AUTH_PREVIEW=

# --- Accounts and cross-device sync (optional) ---
# From the Supabase project's API settings. Without these the app stays local-only:
# no sign-in, no sync. Safe to expose — the publishable key is a client key, and the
# sync tables are protected by row-level security (see supabase/migrations/).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI character bios (optional) ---
# Server-only, read by api/enrichment.ts. Unset means the bio section never appears.
ANTHROPIC_API_KEY=

# --- Push notifications for new episodes (optional) ---
# Generate the pair with: npx web-push generate-vapid-keys
# The public key is needed twice: the VITE_ copy lets the browser subscribe, the
# unprefixed copy lets api/check-episodes.ts sign what it sends. All of these must be
# set or the feature stays hidden rather than half-working. See PUSH_NOTIFICATIONS_SETUP.md.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=            # optional, defaults to mailto:hello@casttracker.app
# Shared secret guarding the daily cron endpoint. Vercel sends it as a bearer token.
CRON_SECRET=
