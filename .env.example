# Free personal API key from https://www.themoviedb.org/settings/api
# Without this, show/cast search & autofill gracefully fall back to manual entry.
VITE_TMDB_API_KEY=

# Server-only copy, read by api/check-episodes.ts. Same value as above for now, but unprefixed
# so Vite never inlines it into the client bundle. Set this one in the Vercel dashboard.
TMDB_API_KEY=

# Sign-up preview screens. Off unless "true". No backend behind them — see src/lib/auth.ts
VITE_ENABLE_AUTH_PREVIEW=
